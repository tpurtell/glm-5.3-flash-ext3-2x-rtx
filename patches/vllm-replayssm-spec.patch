+        B_cache_base
+        + phys_k[:, None] * stride_B_cache_pos
+        + offs_n[None, :] * stride_B_cache_dstate,
+        mask=hist_mask[:, None] & nmask[None, :],
+        other=0.0,
+    )
+    B_specrows = tl.load(
+        B_src_base
+        + spec_off[:, None] * stride_B_spec_tok
+        + offs_n[None, :] * stride_B_spec_dstate,
+        mask=spec_tok[:, None] & nmask[None, :],
