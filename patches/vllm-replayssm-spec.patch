+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Compact speculative decode for the vector-gated KDA recurrence.
+
+KDA normally stores one full recurrent state for every token in the verify
+window so rejection sampling can select the accepted state.  ReplaySSM keeps
+one checkpoint plus a circular ring of the much smaller state-building inputs
+``(d, k, g)``.  A verify step reconstructs the committed state, evaluates the
+whole speculative window, and only advances the ring cursor after sampling.
+
+This is deliberately a separate kernel from scalar-gated GDN ReplaySSM.  KDA's
+gate has shape ``[H, K]`` and decays each state column independently; treating
+it as GDN's scalar gate is numerically wrong even when all other dimensions
+match.
+"""
+
+import torch
+
+from vllm.model_executor.layers.mamba.ops.replayssm_config import (
+    get_replayssm_config,
+)
+from vllm.triton_utils import tl, triton
+
+
+@triton.jit
+def _materialize_kda_replayssm_state_kernel(
+    checkpoint,
+    d_cache,
+    k_cache,
+    g_cache,
+    out,
+    source_indices,
+    has_initial_state,
+    row_write_pos,
+    row_cache_base,
+    stride_state_slot: tl.constexpr,
+    stride_d_slot: tl.constexpr,
+    stride_k_slot: tl.constexpr,
+    stride_g_slot: tl.constexpr,
+    stride_out_row: tl.constexpr,
+    H: tl.constexpr,
+    K: tl.constexpr,
+    V: tl.constexpr,
+    BK: tl.constexpr,
+    BV: tl.constexpr,
+    CACHE_BUF_LEN: tl.constexpr,
+    NULL_BLOCK_ID: tl.constexpr,
+):
+    i_v, i_nh = tl.program_id(0), tl.program_id(1)
+    i_n = i_nh // H
+    i_h = i_nh % H
+    source_idx = tl.load(source_indices + i_n).to(tl.int64)
+    initial = tl.load(has_initial_state + i_n).to(tl.int32) != 0
+    valid = initial & (source_idx > NULL_BLOCK_ID)
+    o_k = tl.arange(0, BK)
+    o_v = i_v * BV + tl.arange(0, BV)
+    mask_k = o_k < K
+    mask_v = o_v < V
+    mask_h = mask_v[:, None] & mask_k[None, :]
+    p_checkpoint = (
+        checkpoint
+        + source_idx * stride_state_slot
+        + i_h * V * K
+        + o_v[:, None] * K
+        + o_k[None, :]
+    )
+    state = tl.load(p_checkpoint, mask=mask_h & valid, other=0.0).to(tl.float32)
+    wp = tl.load(row_write_pos + i_n, mask=valid, other=0).to(tl.int32)
+    base = tl.load(row_cache_base + i_n, mask=valid, other=0).to(tl.int32)
+    for i_c in tl.static_range(0, CACHE_BUF_LEN):
+        active_c = valid & (i_c < wp)
+        phys = (base + i_c) & (CACHE_BUF_LEN - 1)
+        hist_g = tl.load(
+            g_cache
+            + source_idx * stride_g_slot
+            + (i_h * CACHE_BUF_LEN + phys) * K
+            + o_k,
+            mask=mask_k & active_c,
+            other=0.0,
+        ).to(tl.float32)
+        hist_k = tl.load(
+            k_cache
+            + source_idx * stride_k_slot
+            + (i_h * CACHE_BUF_LEN + phys) * K
+            + o_k,
+            mask=mask_k & active_c,
+            other=0.0,
+        ).to(tl.float32)
+        hist_d = tl.load(
+            d_cache
+            + source_idx * stride_d_slot
+            + (i_h * CACHE_BUF_LEN + phys) * V
+            + o_v,
+            mask=mask_v & active_c,
+            other=0.0,
+        ).to(tl.float32)
+        next_state = state * tl.exp(hist_g[None, :])
+        next_state += hist_d[:, None] * hist_k[None, :]
+        state = tl.where(active_c, next_state, state)
+    p_out = (
+        out
+        + i_n * stride_out_row
+        + i_h * V * K
+        + o_v[:, None] * K
+        + o_k[None, :]
+    )
+    tl.store(p_out, state.to(p_out.dtype.element_ty), mask=mask_h)
+
+
+@triton.jit
+def _kda_replayssm_spec_kernel(
+    q,
+    k,
+    v,
+    raw_g,
+    raw_beta,
+    a_log,
+    g_bias,
+    out,
+    checkpoint,
+    d_cache,
+    k_cache,
+    g_cache,
+    query_start_loc,
+    state_indices,
+    write_pos,
+    cache_base,
+    is_flush,
+    scale,
+    stride_q_t: tl.constexpr,
+    stride_q_h: tl.constexpr,
+    stride_k_t: tl.constexpr,
+    stride_k_h: tl.constexpr,
+    stride_v_t: tl.constexpr,
+    stride_v_h: tl.constexpr,
+    stride_g_t: tl.constexpr,
+    stride_g_h: tl.constexpr,
+    stride_beta_t: tl.constexpr,
+    stride_beta_h: tl.constexpr,
+    stride_o_t: tl.constexpr,
+    stride_o_h: tl.constexpr,
+    stride_state_slot: tl.constexpr,
+    stride_d_slot: tl.constexpr,
+    stride_k_slot: tl.constexpr,
+    stride_g_slot: tl.constexpr,
+    stride_qsl: tl.constexpr,
+    stride_indices: tl.constexpr,
+    H: tl.constexpr,
+    K: tl.constexpr,
+    V: tl.constexpr,
+    BK: tl.constexpr,
+    BV: tl.constexpr,
+    MAX_SPEC_LEN: tl.constexpr,
+    CACHE_BUF_LEN: tl.constexpr,
+    LOWER_BOUND: tl.constexpr,
+    IS_FLUSH_KERNEL: tl.constexpr,
+    NULL_BLOCK_ID: tl.constexpr,
+):
+    i_v, i_nh = tl.program_id(0), tl.program_id(1)
+    i_n = i_nh // H
+    i_h = i_nh % H
+
+    bos = tl.load(query_start_loc + i_n * stride_qsl).to(tl.int64)
+    eos = tl.load(query_start_loc + (i_n + 1) * stride_qsl).to(tl.int64)
+    spec_len = eos - bos
+    state_idx = tl.load(state_indices + i_n * stride_indices).to(tl.int64)
+
+    o_k = tl.arange(0, BK)
+    o_v = i_v * BV + tl.arange(0, BV)
+    mask_k = o_k < K
+    mask_v = o_v < V
+    mask_h = mask_v[:, None] & mask_k[None, :]
+
+    if state_idx <= NULL_BLOCK_ID:
+        # Only one specialization zeros padded output rows.
+        if not IS_FLUSH_KERNEL:
+            for i_t in tl.static_range(0, MAX_SPEC_LEN):
+                active = i_t < spec_len
+                p_o = out + (bos + i_t) * stride_o_t + i_h * stride_o_h + o_v
+                tl.store(p_o, tl.zeros([BV], tl.float32), mask=mask_v & active)
+        return
+
+    flush = tl.load(is_flush + state_idx).to(tl.int32) != 0
+    if IS_FLUSH_KERNEL:
+        if not flush:
+            return
+    else:
+        if flush:
+            return
+
+    wp = tl.load(write_pos + state_idx).to(tl.int32)
+    base = tl.load(cache_base + state_idx).to(tl.int32)
+
+    p_checkpoint = (
+        checkpoint
+        + state_idx * stride_state_slot
+        + i_h * V * K
+        + o_v[:, None] * K
+        + o_k[None, :]
+    )
+    state = tl.load(p_checkpoint, mask=mask_h, other=0.0).to(tl.float32)
+
+    # Reconstruct the state represented by the committed ring.  The KDA gate
+    # is vector-valued, so each K column receives its own decay.  A short ring
+    # keeps this sequential replay register-light; it is swept in the recipe.
+    for i_c in tl.static_range(0, CACHE_BUF_LEN):
+        active_c = i_c < wp
+        phys = (base + i_c) & (CACHE_BUF_LEN - 1)
+        p_hist_g = (
+            g_cache
+            + state_idx * stride_g_slot
+            + (i_h * CACHE_BUF_LEN + phys) * K
+            + o_k
+        )
+        p_hist_k = (
+            k_cache
+            + state_idx * stride_k_slot
+            + (i_h * CACHE_BUF_LEN + phys) * K
+            + o_k
+        )
+        p_hist_d = (
+            d_cache
+            + state_idx * stride_d_slot
+            + (i_h * CACHE_BUF_LEN + phys) * V
+            + o_v
+        )
+        hist_g = tl.load(p_hist_g, mask=mask_k & active_c, other=0.0).to(
+            tl.float32
+        )
+        hist_k = tl.load(p_hist_k, mask=mask_k & active_c, other=0.0).to(
+            tl.float32
+        )
+        hist_d = tl.load(p_hist_d, mask=mask_v & active_c, other=0.0).to(
+            tl.float32
+        )
+        next_state = state * tl.exp(hist_g[None, :])
+        next_state += hist_d[:, None] * hist_k[None, :]
+        state = tl.where(active_c, next_state, state)
+
+    # A flush checkpoints committed history, never uncommitted verify tokens.
+    if IS_FLUSH_KERNEL:
+        tl.store(p_checkpoint, state.to(p_checkpoint.dtype.element_ty), mask=mask_h)
+
+    gate_amplitude = tl.exp(tl.load(a_log + i_h).to(tl.float32))
+
+    # Sequential T<=6 evaluation is compact and mirrors the reference KDA
+    # recurrence exactly.  It also exposes d/k/g for cheap rejection rollback.
+    for i_t in tl.static_range(0, MAX_SPEC_LEN):
+        active_t = i_t < spec_len
+        token = bos + i_t
+        p_q = q + token * stride_q_t + i_h * stride_q_h + o_k
+        p_k = k + token * stride_k_t + i_h * stride_k_h + o_k
+        p_v = v + token * stride_v_t + i_h * stride_v_h + o_v
+        p_g = raw_g + token * stride_g_t + i_h * stride_g_h + o_k
+
+        q_t = tl.load(p_q, mask=mask_k & active_t, other=0.0).to(tl.float32)
+        k_t = tl.load(p_k, mask=mask_k & active_t, other=0.0).to(tl.float32)
+        v_t = tl.load(p_v, mask=mask_v & active_t, other=0.0).to(tl.float32)
+        g_t = tl.load(p_g, mask=mask_k & active_t, other=0.0).to(tl.float32)
+
+        q_t *= tl.rsqrt(tl.sum(q_t * q_t, axis=0) + 1e-6)
+        k_t *= tl.rsqrt(tl.sum(k_t * k_t, axis=0) + 1e-6)
+        q_t *= scale
+
+        bias = tl.load(g_bias + i_h * K + o_k, mask=mask_k, other=0.0).to(
+            tl.float32
+        )
+        gate_t = LOWER_BOUND / (1.0 + tl.exp(-(gate_amplitude * (g_t + bias))))
+        decayed = state * tl.exp(gate_t[None, :])
+        residual = v_t - tl.sum(decayed * k_t[None, :], axis=1)
+        beta_t = tl.load(
+            raw_beta + token * stride_beta_t + i_h * stride_beta_h,
+            mask=active_t,
+            other=0.0,
+        ).to(tl.float32)
+        residual *= tl.sigmoid(beta_t)
+        next_state = decayed + residual[:, None] * k_t[None, :]
+        state = tl.where(active_t, next_state, state)
+
+        result = tl.sum(state * q_t[None, :], axis=1)
+        p_o = out + token * stride_o_t + i_h * stride_o_h + o_v
+        tl.store(p_o, result.to(p_o.dtype.element_ty), mask=mask_v & active_t)
+
+        phys = (base + wp + i_t) & (CACHE_BUF_LEN - 1)
+        p_cur_d = (
+            d_cache
+            + state_idx * stride_d_slot
+            + (i_h * CACHE_BUF_LEN + phys) * V
+            + o_v
+        )
+        p_cur_k = (
+            k_cache
+            + state_idx * stride_k_slot
+            + (i_h * CACHE_BUF_LEN + phys) * K
+            + o_k
+        )
+        p_cur_g = (
+            g_cache
+            + state_idx * stride_g_slot
+            + (i_h * CACHE_BUF_LEN + phys) * K
+            + o_k
+        )
+        tl.store(
+            p_cur_d,
+            residual.to(p_cur_d.dtype.element_ty),
+            mask=mask_v & active_t,
+        )
+        # d is V-tiled, whereas k/g are head-wide.  One V tile owns their store.
+        if i_v == 0:
+            tl.store(
+                p_cur_k,
+                k_t.to(p_cur_k.dtype.element_ty),
+                mask=mask_k & active_t,
+            )
+            tl.store(p_cur_g, gate_t, mask=mask_k & active_t)
+
+
+def _launch_kda_replayssm_spec(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    raw_g: torch.Tensor,
+    raw_beta: torch.Tensor,
+    a_log: torch.Tensor,
+    g_bias: torch.Tensor,
+    out: torch.Tensor,
+    checkpoint: torch.Tensor,
+    d_cache: torch.Tensor,
+    k_cache: torch.Tensor,
+    g_cache: torch.Tensor,
+    query_start_loc: torch.Tensor,
+    state_indices: torch.Tensor,
+    write_pos: torch.Tensor,
+    cache_base: torch.Tensor,
+    is_flush: torch.Tensor,
+    max_spec_len: int,
+    lower_bound: float,
+    scale: float,
+    is_flush_kernel: bool,
+    null_block_id: int,
+) -> None:
+    _, _, h, k_dim = q.shape
+    v_dim = v.shape[-1]
+    cache_buf_len = d_cache.shape[2]
+    if cache_buf_len & (cache_buf_len - 1):
+        raise ValueError("KDA ReplaySSM requires a power-of-two physical ring")
+    bk = triton.next_power_of_2(k_dim)
+    if bk != k_dim:
+        raise ValueError(f"KDA ReplaySSM requires power-of-two K, got {k_dim}")
+    block_v, num_warps, _, num_stages = get_replayssm_config(
+        "kda_spec_flush" if is_flush_kernel else "kda_spec_verify",
+        max_spec_len=max_spec_len,
+        head_k_dim=k_dim,
+    )
+    if block_v is None:
+        block_v = min(triton.next_power_of_2(v_dim), 8)
+    n_rows = query_start_loc.shape[0] - 1
+    grid = (triton.cdiv(v_dim, block_v), n_rows * h)
+    _kda_replayssm_spec_kernel[grid](
+        q,
+        k,
+        v,
+        raw_g,
+        raw_beta,
+        a_log,
+        g_bias,
+        out,
+        checkpoint,
+        d_cache,
+        k_cache,
+        g_cache,
+        query_start_loc,
+        state_indices,
+        write_pos,
+        cache_base,
+        is_flush,
+        scale,
+        q.stride(1),
+        q.stride(2),
+        k.stride(1),
+        k.stride(2),
+        v.stride(1),
+        v.stride(2),
+        raw_g.stride(raw_g.ndim - 3),
+        raw_g.stride(-2),
+        raw_beta.stride(raw_beta.ndim - 2),
+        raw_beta.stride(-1),
+        out.stride(1),
+        out.stride(2),
+        checkpoint.stride(0),
+        d_cache.stride(0),
+        k_cache.stride(0),
+        g_cache.stride(0),
+        query_start_loc.stride(0),
+        state_indices.stride(0),
+        H=h,
+        K=k_dim,
+        V=v_dim,
+        BK=bk,
+        BV=block_v,
+        MAX_SPEC_LEN=max_spec_len,
+        CACHE_BUF_LEN=cache_buf_len,
+        LOWER_BOUND=lower_bound,
+        IS_FLUSH_KERNEL=is_flush_kernel,
+        NULL_BLOCK_ID=null_block_id,
+        num_warps=num_warps,
+        num_stages=num_stages,
+    )
+
+
+def kda_replayssm_spec_decode(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    raw_g: torch.Tensor,
+    raw_beta: torch.Tensor,
+    a_log: torch.Tensor,
+    g_bias: torch.Tensor,
+    checkpoint: torch.Tensor,
+    d_cache: torch.Tensor,
+    k_cache: torch.Tensor,
+    g_cache: torch.Tensor,
+    out: torch.Tensor,
+    query_start_loc: torch.Tensor,
+    state_indices: torch.Tensor,
+    write_pos: torch.Tensor,
+    cache_base: torch.Tensor,
+    is_flush: torch.Tensor,
+    max_spec_len: int,
+    lower_bound: float = -5.0,
+    scale: float | None = None,
+    null_block_id: int = 0,
+) -> torch.Tensor:
+    """Run fixed verify+flush launches for CUDA-graph-safe KDA routing."""
+    if scale is None:
+        scale = q.shape[-1] ** -0.5
+    if is_flush.dtype != torch.int8:
+        raise TypeError("is_flush must be int8")
+    for flush in (False, True):
+        _launch_kda_replayssm_spec(
+            q,
+            k,
+            v,
+            raw_g,
+            raw_beta,
+            a_log.reshape(-1),
+            g_bias.reshape(-1),
+            out,
+            checkpoint,
+            d_cache,
+            k_cache,
+            g_cache,
+            query_start_loc,
+            state_indices,
+            write_pos,
+            cache_base,
+            is_flush,
+            max_spec_len,
+            lower_bound,
+            scale,
+            flush,
+            null_block_id,
+        )
+    return out
+
+
+def materialize_kda_replayssm_state(
+    checkpoint: torch.Tensor,
+    d_cache: torch.Tensor,
+    k_cache: torch.Tensor,
+    g_cache: torch.Tensor,
+    out: torch.Tensor,
+    source_indices: torch.Tensor,
+    has_initial_state: torch.Tensor,
+    row_write_pos: torch.Tensor,
+    row_cache_base: torch.Tensor,
+    null_block_id: int = 0,
+) -> torch.Tensor:
+    """Reconstruct exact row initial states for an align-prefix prefill."""
+    n_rows, h, v_dim, k_dim = out.shape
+    if source_indices.shape[0] != n_rows:
+        raise ValueError("ReplaySSM prefill source/state row count mismatch")
+    bk = triton.next_power_of_2(k_dim)
+    if bk != k_dim:
+        raise ValueError(f"KDA ReplaySSM requires power-of-two K, got {k_dim}")
+    cache_buf_len = d_cache.shape[2]
+    if cache_buf_len & (cache_buf_len - 1):
+        raise ValueError("KDA ReplaySSM requires a power-of-two physical ring")
+    block_v = min(triton.next_power_of_2(v_dim), 8)
+    grid = (triton.cdiv(v_dim, block_v), n_rows * h)
+    _materialize_kda_replayssm_state_kernel[grid](
+        checkpoint,
+        d_cache,
+        k_cache,
+        g_cache,
+        out,
+        source_indices,
+        has_initial_state,
+        row_write_pos,
+        row_cache_base,
+        checkpoint.stride(0),
+        d_cache.stride(0),
+        k_cache.stride(0),
+        g_cache.stride(0),
+        out.stride(0),
+        H=h,
+        K=k_dim,
+        V=v_dim,
+        BK=bk,
+        BV=block_v,
+        CACHE_BUF_LEN=cache_buf_len,
+        NULL_BLOCK_ID=null_block_id,
+        num_warps=1,
+        num_stages=2,
+    )
+    return out
